configuration {
    modi: "drun,filebrowser,window,run";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Tela-circle-dracula";

    display-drun: "󰀻";
    display-run: "󰆍";
    display-filebrowser: "";
    display-window: "󰖲";

    drun-display-format: "{name}";
    hover-select: false;
    scroll-method: 1;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    window-format: "{w} · {c} · {t}";
}

@theme "~/.config/rofi/colors.rasi"

window {
    width: 32em;
    location: center;
    anchor: center;

    padding: 1em;
    border: 0.12em;
    border-color: @outline;
    border-radius: 1.2em;

    background-color: @surface;
    transparency: "real";
}

mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 0.8em;
    padding: 0em;

    children: [
        "inputbar",
        "mode-switcher",
        "listview",
        "message"
    ];

    background-color: transparent;
}

inputbar {
    enabled: true;
    spacing: 0.5em;
    padding: 0.75em 0.9em;

    children: [
        "textbox-prompt-colon",
        "entry"
    ];

    background-color: @surface-container;
    border-radius: 0.9em;
}

textbox-prompt-colon {
    enabled: true;
    expand: false;

    str: "󰍉";
    padding: 0em;

    text-color: @on-surface-variant;
    background-color: transparent;
}

entry {
    enabled: true;
    spacing: 0.5em;
    padding: 0em;

    text-color: @on-surface;
    cursor: text;

    placeholder: "Search";
    placeholder-color: @on-surface-variant;

    background-color: transparent;
}

mode-switcher {
    enabled: true;
    orientation: horizontal;

    spacing: 0.5em;
    padding: 0em;

    background-color: transparent;
}

button {
    enabled: true;
    expand: true;

    padding: 0.55em 0.7em;
    border-radius: 0.75em;

    cursor: pointer;

    background-color: @surface-container;
    text-color: @on-surface;
}

button selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

listview {
    enabled: true;

    columns: 1;
    lines: 8;

    dynamic: true;
    fixed-height: false;
    fixed-columns: true;

    cycle: true;
    reverse: false;
    layout: vertical;

    spacing: 0.4em;
    padding: 0em;

    scrollbar: false;

    background-color: transparent;
}

element {
    enabled: true;

    padding: 0.65em 0.8em;
    spacing: 0.8em;

    cursor: pointer;
    border-radius: 0.8em;

    background-color: @surface-container;
    text-color: @on-surface;
}

element normal {
    background-color: @surface-container;
    text-color: @on-surface;
}

element alternate {
    background-color: @surface-container;
    text-color: @on-surface;
}

element active {
    background-color: @surface-container;
    text-color: @on-surface;
}

element urgent {
    background-color: @surface-container;
    text-color: @on-surface;
}

element selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element-icon {
    enabled: true;
    size: 2.2em;

    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    enabled: true;

    vertical-align: 0.5;
    horizontal-align: 0.0;

    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

message {
    enabled: true;

    padding: 0.4em 0em 0em 0em;

    background-color: transparent;
    text-color: @on-surface-variant;
}

textbox {
    padding: 0.5em 0em;

    background-color: transparent;
    text-color: @on-surface-variant;

    vertical-align: 0.5;
    horizontal-align: 0.0;
}

error-message {
    padding: 0.8em;

    border-radius: 0.9em;

    background-color: @surface-container;
    text-color: @on-surface;
}
