/* ─────────────────────────────────────────────
 * Cliphist
 * ───────────────────────────────────────────── */

configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;

    hover-select: false;
    scroll-method: 1;

    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    window-format: "{w} · {c} · {t}";
}


/* ─────────────────────────────────────────────
 * Theme
 * ───────────────────────────────────────────── */

@theme "~/.config/rofi/colors.rasi"


/* ─────────────────────────────────────────────
 * Window
 * ───────────────────────────────────────────── */

window {
    width: 30em;

    location: northeast;
    anchor: northeast;

    x-offset: -2em;
    y-offset: 2em;

    padding: 1em;

    border: 0.12em;
    border-color: @outline;
    border-radius: 1.2em;

    background-color: @surface;

    transparency: "real";
}


/* ─────────────────────────────────────────────
 * Main layout
 * ───────────────────────────────────────────── */

mainbox {
    enabled: true;

    orientation: vertical;

    spacing: 0.7em;
    padding: 0em;

    children: [
        "inputbar",
        "listview",
        "message"
    ];

    background-color: transparent;
}


/* ─────────────────────────────────────────────
 * Search
 * ───────────────────────────────────────────── */

inputbar {
    enabled: true;

    spacing: 0.5em;
    padding: 0.75em 0.9em;

    children: [
        "textbox-prompt-colon",
        "entry"
    ];

    background-color: @surface-container;
    border-radius: 0.9em;
}

textbox-prompt-colon {
    enabled: true;
    expand: false;

    str: "󰍉";

    padding: 0em;

    text-color: @on-surface-variant;
    background-color: transparent;
}

entry {
    enabled: true;

    spacing: 0.5em;
    padding: 0em;

    text-color: @on-surface;

    cursor: text;

    placeholder: "Search clipboard";
    placeholder-color: @on-surface-variant;

    background-color: transparent;
}


/* ─────────────────────────────────────────────
 * Clipboard list
 * ───────────────────────────────────────────── */

listview {
    enabled: true;

    columns: 1;
    lines: 8;

    dynamic: true;

    fixed-height: false;
    fixed-columns: true;

    cycle: true;
    reverse: false;

    layout: vertical;

    spacing: 0.4em;
    padding: 0em;

    scrollbar: false;

    background-color: transparent;
}


/* ─────────────────────────────────────────────
 * Clipboard entries
 * ───────────────────────────────────────────── */

element {
    enabled: true;

    padding: 0.65em 0.9em;
    spacing: 0.7em;

    cursor: pointer;

    border-radius: 0.75em;

    background-color: @surface-container;
    text-color: @on-surface;
}


/* Normal entries */

element normal {
    background-color: @surface-container;
    text-color: @on-surface;
}


/* Alternate entries */

element alternate {
    background-color: @surface-container;
    text-color: @on-surface;
}


/* Active entries */

element active {
    background-color: @surface-container;
    text-color: @on-surface;
}


/* Urgent entries */

element urgent {
    background-color: @surface-container;
    text-color: @on-surface;
}


/* Selected entry */

element selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}


/* ─────────────────────────────────────────────
 * Entry text
 * ───────────────────────────────────────────── */

element-text {
    enabled: true;

    horizontal-align: 0.0;
    vertical-align: 0.5;

    cursor: inherit;

    background-color: transparent;
    text-color: inherit;
}


/* ─────────────────────────────────────────────
 * Entry icons
 * ───────────────────────────────────────────── */

element-icon {
    enabled: false;

    size: 0em;

    cursor: inherit;

    background-color: transparent;
    text-color: inherit;
}


/* ─────────────────────────────────────────────
 * Messages
 * ───────────────────────────────────────────── */

message {
    enabled: true;

    padding: 0.7em 0em 0em 0em;

    background-color: transparent;
    text-color: @on-surface-variant;
}

textbox {
    padding: 0.5em 0em;

    background-color: transparent;
    text-color: @on-surface-variant;

    vertical-align: 0.5;
    horizontal-align: 0.0;
}


/* ─────────────────────────────────────────────
 * Error message
 * ───────────────────────────────────────────── */

error-message {
    padding: 0.8em;

    border-radius: 0.9em;

    background-color: @surface-container;
    text-color: @on-surface;
}
